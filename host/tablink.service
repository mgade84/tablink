# Optional: run the host as a user service.
#   cp host/tablink.service ~/.config/systemd/user/
#   (edit ExecStart path if the repo lives elsewhere)
#   systemctl --user daemon-reload && systemctl --user enable --now tablink
# The tablet still needs `adb reverse tcp:27183 tcp:27183` after each plug-in
# (scripts/run.sh does that).
[Unit]
Description=TabLink host
After=graphical-session.target
PartOf=graphical-session.target

[Service]
WorkingDirectory=%h/code/tablink/host
ExecStart=/usr/bin/python3 -m tablink
Restart=on-failure

[Install]
WantedBy=graphical-session.target
